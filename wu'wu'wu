<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>灰度毛玻璃 UI 排版</title>
<style>
    /* 基础重置与背景 */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #1a1a1a;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* 主容器：竖版比例 */
    .ui-container {
        width: 390px;
        height: 844px;
        position: relative;
        border-radius: 40px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        background-color: #333; /* 兜底背景色 */
    }

    /* 底层背景图（独立一层，处理灰度，不影响上层毛玻璃） */
    .bg-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* 你可以在这里替换你自己的背景图链接 */
        background-image: url('https://images.unsplash.com/photo-1518005020951-eccb494ad742?q=80&w=1000&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        filter: grayscale(100%) brightness(0.6) contrast(1.2);
        z-index: 1;
    }

    /* 内部内容层 */
    .content-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 30px 20px 20px 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        z-index: 10;
    }

    /* 通用毛玻璃卡片样式 */
    .glass-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        position: relative;
        overflow: hidden;
    }

    /* 内部虚线占位框 */
    .placeholder-box {
        width: 100%;
        height: 100%;
        border: 1px dashed rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: rgba(255, 255, 255, 0.5);
        font-size: 12px;
        letter-spacing: 1px;
        padding: 10px;
    }

    /* --- 顶部区域 --- */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        height: 80px;
    }
    .avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .header-mid {
        flex: 1;
        margin: 10px 15px 0 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .line-short {
        width: 80px;
        height: 12px;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 6px;
    }
    .progress-bar {
        width: 100%;
        height: 8px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 4px;
        position: relative;
    }
    .progress-bar::after {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 35%;
        height: 100%;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 4px;
    }
    .header-right {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.15);
    }

    /* --- 中部主内容区 --- */
    .main-content {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        grid-template-rows: auto auto;
        gap: 15px;
        flex: 1;
    }

    /* 左侧主图 */
    .big-image-box {
        grid-column: 1 / 2;
        grid-row: 1 / 2;
        height: 240px;
    }

    /* 左侧底部文本框 */
    .text-box {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        height: 160px;
    }

    /* 右上角小播放器 */
    .mini-player {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        height: 110px;
        display: flex;
        padding: 10px;
        gap: 10px;
        align-items: center;
    }
    .mini-player .cover {
        width: 70px;
        height: 70px;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 8px;
        flex-shrink: 0;
    }
    .mini-player .controls {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        color: #fff;
        gap: 12px;
    }
    .mini-player .controls span {
        font-size: 12px;
        opacity: 0.9;
    }
    .icons-row {
        display: flex;
        gap: 15px;
        font-size: 14px;
        opacity: 0.8;
    }

    /* 右下角大播放器 */
    .full-player {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        height: 290px;
        display: flex;
        flex-direction: column;
        padding: 15px;
    }
    .full-player .cover-large {
        width: 100%;
        flex: 1;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        margin-bottom: 20px;
    }
    .full-player .controls-large {
        display: flex;
        justify-content: space-around;
        align-items: center;
        color: #fff;
        font-size: 20px;
        margin-bottom: 20px;
    }
    /* 进度条 */
    .track-bar {
        height: 3px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 2px;
        position: relative;
        margin-bottom: 10px;
    }
    .track-bar .fill {
        position: absolute;
        left: 0;
        width: 60%;
        height: 100%;
        background: #fff;
        border-radius: 2px;
    }
    .track-bar .dot {
        position: absolute;
        left: 60%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background: #fff;
        border-radius: 50%;
    }

    /* --- 底部导航栏 --- */
    .bottom-nav {
        height: 60px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        margin-top: auto;
        margin-bottom: 10px;
    }
    .nav-item {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: 0.3s;
    }
    .nav-item.active {
        background: rgba(255, 255, 255, 0.4);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    }
</style>
</head>
<body>

<div class="ui-container">
    <!-- 独立底层背景 -->
    <div class="bg-layer"></div>

    <!-- 内容层 -->
    <div class="content-wrapper">
        
        <!-- 顶部信息栏 -->
        <div class="header">
            <div class="avatar glass-card"></div>
            <div class="header-mid">
                <div class="line-short"></div>
                <div class="progress-bar"></div>
            </div>
            <div class="header-right glass-card"></div>
        </div>

        <!-- 中间核心内容区 -->
        <div class="main-content">
            
            <!-- 左上主图位 -->
            <div class="glass-card big-image-box">
                <div class="placeholder-box">主图留空位</div>
            </div>

            <!-- 左下文本位 -->
            <div class="glass-card text-box">
                <div class="placeholder-box" style="justify-content: flex-start; align-items: flex-start;">
                    ♡ 고독해서 미칠 것 같아...
                </div>
            </div>

            <!-- 右上角小播放器 -->
            <div class="glass-card mini-player">
                <div class="cover"></div>
                <div class="controls">
                    <span>久见 ♫</span>
                    <div class="icons-row">
                        <span>⏮</span><span>⏸</span><span>⏭</span>
                    </div>
                </div>
            </div>

            <!-- 右下角大播放器 -->
            <div class="glass-card full-player">
                <div class="cover-large"></div>
                <div class="controls-large">
                    <span>⏮</span>
                    <span>⏸</span>
                    <span>⏭</span>
                </div>
                <div class="track-bar">
                    <div class="fill"></div>
                    <div class="dot"></div>
                </div>
            </div>
        </div>

        <!-- 底部导航栏 -->
        <div class="bottom-nav">
            <div class="nav-item"></div>
            <div class="nav-item"></div>
            <div class="nav-item active"></div>
            <div class="nav-item"></div>
            <div class="nav-item"></div>
        </div>

    </div>
</div>

</body>
</html>
